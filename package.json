{
	"extensionKind": [
		"workspace",
		"ui"
	],
	"name": "pharo-language-server",
	"displayName": "Pharo Language Support",
	"description": "%extension.description%",
	"author": "Benoît Verhaeghe",
	"license": "MIT",
	"version": "2.3.0",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/badetitou/vscode-pharo"
	},
	"publisher": "badetitou",
	"categories": [
		"Formatters",
		"Programming Languages",
		"Snippets",
		"Debuggers",
		"Notebooks",
		"Testing"
	],
	"keywords": [
		"pharo",
		"smalltalk",
		"ston"
	],
	"engines": {
		"vscode": "^1.125.0"
	},
	"activationEvents": [
		"onLanguage:pharo",
		"onDebugResolve:pharodb",
		"onFileSystem:pharoImage",
		"onFileSystem:pharo",
		"onNotebook:moosebook",
		"onChatParticipant:pharo-language-server.pharo"
	],
	"extensionDependencies": [
		"mindaro-dev.file-downloader",
		"badetitou.pharo-highlighter"
	],
	"main": "./dist/extension",
	"contributes": {
		"configurationDefaults": {
			"workbench.editor.customLabels.patterns": {
				"/*/*/*/instance/*.st": "${dirname(1)}>>${filename}",
				"/*/*/*/class/*.st": "${dirname(1)} class>>${filename}"
			}
		},
		"chatParticipants": [
			{
				"id": "pharo-language-server.pharo",
				"name": "pharo",
				"fullName": "Pharo",
				"description": "%chatParticipant.pharo.description%",
				"isSticky": true,
				"disambiguation": [
					{
						"category": "pharo",
						"description": "%chatParticipant.pharo.disambiguation.description%",
						"examples": [
							"%chatParticipant.pharo.disambiguation.example.createClass%",
							"%chatParticipant.pharo.disambiguation.example.readClass%",
							"%chatParticipant.pharo.disambiguation.example.runTests%"
						]
					}
				],
				"commands": [
					{
						"name": "help",
						"description": "%chatParticipant.pharo.command.help.description%"
					},
					{
						"name": "createPackage",
						"description": "%chatParticipant.pharo.command.createPackage.description%"
					},
					{
						"name": "createClass",
						"description": "%chatParticipant.pharo.command.createClass.description%"
					},
					{
						"name": "readClass",
						"description": "%chatParticipant.pharo.command.readClass.description%"
					},
					{
						"name": "listPackages",
						"description": "%chatParticipant.pharo.command.listPackages.description%"
					},
					{
						"name": "listClasses",
						"description": "%chatParticipant.pharo.command.listClasses.description%"
					},
					{
						"name": "eval",
						"description": "%chatParticipant.pharo.command.eval.description%"
					},
					{
						"name": "runClassTests",
						"description": "%chatParticipant.pharo.command.runClassTests.description%"
					},
					{
						"name": "runTest",
						"description": "%chatParticipant.pharo.command.runTest.description%"
					}
				]
			}
		],
		"languageModelTools": [
			{
				"name": "pharo-create-package",
				"displayName": "Pharo: créer un package",
				"modelDescription": "%lmTool.createPackage.modelDescription%",
				"userDescription": "%lmTool.createPackage.userDescription%",
				"toolReferenceName": "pharoCreatePackage",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"workspace",
					"create"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"packageName": {
							"type": "string",
							"description": "%lmTool.createPackage.input.packageName.description%"
						}
					},
					"required": [
						"packageName"
					]
				}
			},
			{
				"name": "pharo-create-class",
				"displayName": "Pharo: créer une classe",
				"modelDescription": "%lmTool.createClass.modelDescription%",
				"userDescription": "%lmTool.createClass.userDescription%",
				"toolReferenceName": "pharoCreateClass",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"create"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"packageName": {
							"type": "string"
						},
						"className": {
							"type": "string"
						},
						"superclassName": {
							"type": "string",
							"default": "Object"
						},
						"instanceVariables": {
							"type": "string",
							"description": "%lmTool.createClass.input.instanceVariables.description%"
						}
					},
					"required": [
						"packageName",
						"className"
					]
				}
			},
			{
				"name": "pharo-read-class",
				"displayName": "Pharo: lire une classe",
				"modelDescription": "%lmTool.readClass.modelDescription%",
				"userDescription": "%lmTool.readClass.userDescription%",
				"toolReferenceName": "pharoReadClass",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"read"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"className": {
							"type": "string"
						}
					},
					"required": [
						"className"
					]
				}
			},
			{
				"name": "pharo-list-packages",
				"displayName": "Pharo: lister les packages",
				"modelDescription": "%lmTool.listPackages.modelDescription%",
				"userDescription": "%lmTool.listPackages.userDescription%",
				"toolReferenceName": "pharoListPackages",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"read",
					"list"
				],
				"inputSchema": {
					"type": "object",
					"properties": {}
				}
			},
			{
				"name": "pharo-list-classes",
				"displayName": "Pharo: lister les classes",
				"modelDescription": "%lmTool.listClasses.modelDescription%",
				"userDescription": "%lmTool.listClasses.userDescription%",
				"toolReferenceName": "pharoListClasses",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"read",
					"list"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"packageName": {
							"type": "string"
						}
					},
					"required": [
						"packageName"
					]
				}
			},
			{
				"name": "pharo-eval",
				"displayName": "Pharo: exécuter du code",
				"modelDescription": "%lmTool.eval.modelDescription%",
				"userDescription": "%lmTool.eval.userDescription%",
				"toolReferenceName": "pharoEval",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"execute"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"code": {
							"type": "string"
						}
					},
					"required": [
						"code"
					]
				}
			},
			{
				"name": "pharo-run-class-tests",
				"displayName": "Pharo: exécuter tests de classe",
				"modelDescription": "%lmTool.runClassTests.modelDescription%",
				"userDescription": "%lmTool.runClassTests.userDescription%",
				"toolReferenceName": "pharoRunClassTests",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"test"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"className": {
							"type": "string"
						}
					},
					"required": [
						"className"
					]
				}
			},
			{
				"name": "pharo-run-test-method",
				"displayName": "Pharo: exécuter un test",
				"modelDescription": "%lmTool.runTestMethod.modelDescription%",
				"userDescription": "%lmTool.runTestMethod.userDescription%",
				"toolReferenceName": "pharoRunTestMethod",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"test"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"className": {
							"type": "string"
						},
						"testMethod": {
							"type": "string"
						}
					},
					"required": [
						"className",
						"testMethod"
					]
				}
			},
			{
				"name": "pharo-ice-list-changes",
				"displayName": "Pharo Iceberg: lister les modifications",
				"modelDescription": "%lmTool.iceListChanges.modelDescription%",
				"userDescription": "%lmTool.iceListChanges.userDescription%",
				"toolReferenceName": "pharoIceListChanges",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"iceberg",
					"git",
					"diff"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"repositoryName": {
							"type": "string",
							"description": "%lmTool.iceListChanges.input.repositoryName.description%"
						}
					}
				}
			},
			{
				"name": "pharo-ice-show-diff",
				"displayName": "Pharo Iceberg: afficher le diff",
				"modelDescription": "%lmTool.iceShowDiff.modelDescription%",
				"userDescription": "%lmTool.iceShowDiff.userDescription%",
				"toolReferenceName": "pharoIceShowDiff",
				"canBeReferencedInPrompt": true,
				"tags": [
					"pharo",
					"smalltalk",
					"iceberg",
					"git",
					"diff"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"uri": {
							"type": "string",
							"description": "%lmTool.iceShowDiff.input.uri.description%"
						},
						"repositoryName": {
							"type": "string",
							"description": "%lmTool.iceShowDiff.input.repositoryName.description%"
						},
						"openEditor": {
							"type": "boolean",
							"description": "%lmTool.iceShowDiff.input.openEditor.description%",
							"default": true
						}
					},
					"required": [
						"uri"
					]
				}
			}
		],
		"configuration": {
			"type": "object",
			"title": "Pharo",
			"properties": {
				"pharo.pathToVM": {
					"title": "Path to VM",
					"scope": "window",
					"type": "string",
					"default": "pharo",
					"description": "%configuration.pharo.pathToVM.description%",
					"ignoreSync": true
				},
				"pharo.pathToImage": {
					"title": "Path to Image",
					"scope": "window",
					"type": "string",
					"default": "",
					"description": "%configuration.pharo.pathToImage.description%",
					"ignoreSync": true
				},
				"pharo.imageWorkspace": {
					"title": "Expose Pharo Image Workspace",
					"scope": "window",
					"type": "boolean",
					"default": false,
					"description": "%configuration.pharo.imageWorkspace.description%"
				},
				"pharo.headless": {
					"title": "Headless",
					"scope": "window",
					"type": "boolean",
					"default": true,
					"description": "%configuration.pharo.headless.description%"
				},
				"pharo.debugMode": {
					"title": "Debug mode",
					"scope": "window",
					"type": "boolean",
					"default": false,
					"description": "%configuration.pharo.debugMode.description%"
				},
				"pharo quick install.image name": {
					"title": "Quick install image name",
					"scope": "window",
					"type": "string",
					"default": "Moose64-12-PLS",
					"description": "%configuration.pharo.quickInstall.imageName.description%"
				},
				"pharo quick install.server version": {
					"title": "Quick install server version",
					"scope": "window",
					"type": "string",
					"default": "5.2.0",
					"description": "%configuration.pharo.quickInstall.serverVersion.description%"
				},
				"pharo quick install.server VM version": {
					"title": "Quick install server VM version",
					"scope": "window",
					"type": "string",
					"default": "120",
					"description": "%configuration.pharo.quickInstall.serverVmVersion.description%"
				},
				"pharoLanguageServer.trace.server": {
					"title": "Trace Level",
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off"
				}
			}
		},
		"views": {
			"pharoView": [
				{
					"id": "images",
					"name": "%views.images.name%",
					"icon": "media/pharo-bar.svg"
				},
				{
					"id": "pharoProjects",
					"name": "%views.projects.name%",
					"icon": "media/pharo-bar.svg"
				},
				{
					"id": "pharoBindingView",
					"name": "Variables",
					"icon": "media/pharo-bar.svg"
				}
			]
		},
		"icons": {
			"pls-icon": {
				"description": "%icons.plsIcon.description%",
				"default": {
					"fontPath": "res/pls-font.woff",
					"fontCharacter": "\\41"
				}
			},
			"moose-icon": {
				"description": "%icons.mooseIcon.description%",
				"default": {
					"fontPath": "res/pls-font.woff",
					"fontCharacter": "\\42"
				}
			}
		},
		"viewsWelcome": [
			{
				"view": "pharoBindingView",
				"contents": "Start by executing a selected piece of code with 'Ctrl + Alt + D'"
			},
			{
				"view": "pharoProjects",
				"contents": "%views.projects.welcome%",
				"when": "!pharo.env"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"icon": "media/pharo-bar.svg",
					"id": "pharoView",
					"title": "Pharo"
				}
			]
		},
		"languages": [
			{
				"id": "moosebook",
				"extensions": [
					".moosebook"
				],
				"icon": {
					"light": "./media/moose-logo.svg",
					"dark": "./media/moose-logo.svg"
				}
			}
		],
		"commands": [
			{
				"command": "pharo.env.openEntity",
				"title": "%commands.pharo.env.openEntity.title%",
				"category": "Pharo",
				"icon": "$(symbol-method)"
			},
			{
				"command": "pharo.env.newMethod",
				"title": "%commands.pharo.env.newMethod.title%",
				"category": "Pharo",
				"icon": "$(add)"
			},
			{
				"command": "pharo.projects.refresh",
				"title": "%commands.pharo.projects.refresh.title%",
				"category": "Pharo",
				"icon": "$(refresh)"
			},
			{
				"command": "pharo.projects.filter",
				"title": "%commands.pharo.projects.filter.title%",
				"category": "Pharo",
				"icon": "$(filter)"
			},
			{
				"command": "pharo.projects.clearFilter",
				"title": "%commands.pharo.projects.clearFilter.title%",
				"category": "Pharo",
				"icon": "$(clear-all)"
			},
			{
				"command": "pharo.projects.showAll",
				"title": "%commands.pharo.projects.showAll.title%",
				"category": "Pharo",
				"icon": "$(eye)"
			},
			{
				"command": "pharo.projects.showDefault",
				"title": "%commands.pharo.projects.showDefault.title%",
				"category": "Pharo",
				"icon": "$(eye-closed)"
			},
			{
				"command": "pharo.projects.reveal",
				"title": "%commands.pharo.projects.reveal.title%",
				"category": "Pharo",
				"icon": "$(target)"
			},
			{
				"command": "pharo.projects.pin",
				"title": "%commands.pharo.projects.pin.title%",
				"category": "Pharo",
				"icon": "$(pin)"
			},
			{
				"command": "pharo.projects.unpin",
				"title": "%commands.pharo.projects.unpin.title%",
				"category": "Pharo",
				"icon": "$(pinned)"
			},
			{
				"command": "pharo.projects.hide",
				"title": "%commands.pharo.projects.hide.title%",
				"category": "Pharo",
				"icon": "$(eye-closed)"
			},
			{
				"command": "pharo.projects.unhide",
				"title": "%commands.pharo.projects.unhide.title%",
				"category": "Pharo",
				"icon": "$(eye)"
			},
			{
				"command": "pharo.projects.newPackage",
				"title": "%commands.pharo.projects.newPackage.title%",
				"category": "Pharo",
				"icon": "$(new-folder)"
			},
			{
				"command": "pharo.projects.newClass",
				"title": "%commands.pharo.projects.newClass.title%",
				"category": "Pharo",
				"icon": "$(symbol-class)"
			},
			{
				"command": "pharo.projects.runTests",
				"title": "%commands.pharo.projects.runTests.title%",
				"category": "Pharo",
				"icon": "$(play)"
			},
			{
				"command": "pharo.projects.openDefinition",
				"title": "%commands.pharo.projects.openDefinition.title%",
				"category": "Pharo",
				"icon": "$(go-to-file)"
			},
			{
				"command": "pharo.projects.newMethod",
				"title": "%commands.pharo.projects.newMethod.title%",
				"category": "Pharo",
				"icon": "$(add)"
			},
			{
				"command": "pharo.projects.commit",
				"title": "%commands.pharo.projects.commit.title%",
				"category": "Pharo",
				"icon": "$(check)"
			},
			{
				"command": "pharo.tests.refresh",
				"title": "%commands.pharo.tests.refresh.title%",
				"category": "Pharo Tests",
				"icon": "$(refresh)"
			},
			{
				"command": "pharo.tests.rerunFailed",
				"title": "%commands.pharo.tests.rerunFailed.title%",
				"category": "Pharo Tests",
				"icon": "$(debug-rerun)"
			},
			{
				"command": "pharo.browseImage",
				"title": "Browse Pharo Image",
				"enablement": "false"
			},
			{
				"command": "pharo.images.play",
				"title": "%commands.pharo.images.play.title%",
				"category": "Pharo",
				"icon": "$(play)"
			},
			{
				"command": "pharo.images.refresh",
				"title": "%commands.pharo.images.refresh.title%",
				"category": "Pharo",
				"icon": "$(refresh)"
			},
			{
				"command": "pharo.images.download",
				"title": "%commands.pharo.images.download.title%",
				"category": "Pharo",
				"icon": "$(cloud-download)"
			},
			{
				"command": "pharo.selectImage",
				"title": "%commands.pharo.selectImage.title%",
				"category": "Pharo",
				"icon": "$(database)"
			},
			{
				"command": "pharo.extensionVersion",
				"title": "Show Pharo Language Server Version",
				"category": "Pharo"
			},
			{
				"command": "pharo.diagnose",
				"title": "%commands.pharo.diagnose.title%",
				"category": "Pharo Developer"
			},
			{
				"command": "pharo.save",
				"title": "Save the Pharo image",
				"category": "Pharo"
			},
			{
				"command": "pharo.createPackage",
				"title": "Create Package",
				"category": "Pharo",
				"icon": "$(package)"
			},
			{
				"command": "pharo.createClass",
				"title": "Create Class",
				"category": "Pharo",
				"icon": "$(symbol-class)"
			},
			{
				"command": "pharo.printIt",
				"title": "Print the result of selected lines",
				"category": "Pharo"
			},
			{
				"command": "pharo.showIt",
				"title": "Show the result of selected lines",
				"category": "Pharo"
			},
			{
				"command": "pharo.doIt",
				"title": "Execute the result of selected lines",
				"category": "Pharo"
			},
			{
				"command": "pharo.installIt",
				"title": "Install the last version of the language server",
				"category": "Pharo"
			},
			{
				"command": "pharo.createProject",
				"title": "Create a new Pharo project",
				"category": "Pharo"
			},
			{
				"command": "pharo.addImageToWorkspace",
				"title": "Add Image To Workspace",
				"category": "Pharo Developer"
			},
			{
				"command": "pharo.executeTest",
				"title": "Execute the test",
				"category": "Pharo",
				"when": false
			},
			{
				"command": "pharo.executeClassTests",
				"title": "Execute all class tests",
				"category": "Pharo",
				"when": false
			},
			{
				"command": "extension.pharo-debug.debugEditorContents",
				"title": "Debug File",
				"category": "Pharo Debug",
				"when": "resourceLangId == markdown",
				"icon": "$(debug-alt)"
			},
			{
				"command": "pharo.openLog",
				"title": "Open Log",
				"category": "Pharo Developer"
			},
			{
				"command": "pharo.openImage",
				"title": "Open Pharo Image",
				"category": "Pharo Developer"
			},
			{
				"command": "pharo.ice.refresh",
				"title": "Refresh Iceberg Repositories",
				"category": "Pharo Git"
			},
			{
				"command": "pharo.ice.commit",
				"title": "Commit Iceberg Repository",
				"category": "Pharo Git",
				"icon": "$(check)"
			},
			{
				"command": "pharo.ice.push",
				"title": "Push Iceberg Repository",
				"category": "Pharo Git",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "pharo.ice.addPackage",
				"title": "Add Package To Iceberg Repository",
				"category": "Pharo Git"
			},
			{
				"command": "pharo.clearLog",
				"title": "Clear Log",
				"category": "Pharo Developer"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "pharo.images.download",
					"when": "view == images",
					"group": "navigation@0"
				},
				{
					"command": "pharo.images.refresh",
					"when": "view == images",
					"group": "navigation@1"
				},
				{
					"command": "pharo.projects.filter",
					"when": "view == pharoProjects",
					"group": "navigation@0"
				},
				{
					"command": "pharo.projects.clearFilter",
					"when": "view == pharoProjects && pharo.projects.filtered",
					"group": "navigation@1"
				},
				{
					"command": "pharo.projects.showAll",
					"when": "view == pharoProjects && !pharo.projects.showAll",
					"group": "navigation@2"
				},
				{
					"command": "pharo.projects.showDefault",
					"when": "view == pharoProjects && pharo.projects.showAll",
					"group": "navigation@2"
				},
				{
					"command": "pharo.projects.reveal",
					"when": "view == pharoProjects",
					"group": "navigation@3"
				},
				{
					"command": "pharo.projects.refresh",
					"when": "view == pharoProjects",
					"group": "navigation@4"
				}
			],
			"view/item/context": [
				{
					"command": "pharo.images.play",
					"when": "view == images && viewItem == pharoImages.image",
					"group": "inline"
				},
				{
					"command": "pharo.projects.pin",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bunpinned\\b/",
					"group": "inline@1"
				},
				{
					"command": "pharo.projects.unpin",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bpinned\\b/",
					"group": "inline@1"
				},
				{
					"command": "pharo.projects.pin",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bunpinned\\b/",
					"group": "1_visibility@1"
				},
				{
					"command": "pharo.projects.unpin",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bpinned\\b/",
					"group": "1_visibility@1"
				},
				{
					"command": "pharo.projects.hide",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bshown\\b/",
					"group": "1_visibility@2"
				},
				{
					"command": "pharo.projects.unhide",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b.*\\bhidden\\b/",
					"group": "1_visibility@2"
				},
				{
					"command": "pharo.projects.newPackage",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.project\\b/",
					"group": "2_create@1"
				},
				{
					"command": "pharo.projects.newClass",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.(package|tag)\\b/ && pharo.envEdit",
					"group": "2_create@2"
				},
				{
					"command": "pharo.projects.newMethod",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.class\\b/ && pharo.envEdit",
					"group": "2_create@3"
				},
				{
					"command": "pharo.projects.openDefinition",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.(project|class)\\b/ && pharo.envEdit",
					"group": "3_navigate@1"
				},
				{
					"command": "pharo.projects.runTests",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.(project|package)\\b/",
					"group": "4_test@1"
				},
				{
					"command": "pharo.projects.commit",
					"when": "view == pharoProjects && viewItem =~ /^pharo\\.(project|package)\\b.*\\biceberg\\b/",
					"group": "5_iceberg@1"
				}
			],
			"editor/context": [
				{
					"command": "pharo.showIt",
					"when": "editorLangId == pharo",
					"group": "Pharo@1"
				},
				{
					"command": "pharo.printIt",
					"when": "editorLangId == pharo",
					"group": "Pharo@1"
				},
				{
					"command": "pharo.doIt",
					"when": "editorLangId == pharo",
					"group": "Pharo@1"
				}
			],
			"editor/title": [
				{
					"command": "pharo.env.newMethod",
					"when": "pharo.envEdit && resourceScheme == pharo",
					"group": "navigation@1"
				},
				{
					"command": "extension.pharo-debug.debugEditorContents",
					"when": "resourceLangId == pharo",
					"group": "Pharo@2"
				}
			],
			"commandPalette": [
				{
					"command": "pharo.env.openEntity",
					"when": "pharo.envEdit"
				},
				{
					"command": "pharo.env.newMethod",
					"when": "pharo.envEdit"
				},
				{
					"command": "pharo.projects.pin",
					"when": "false"
				},
				{
					"command": "pharo.projects.unpin",
					"when": "false"
				},
				{
					"command": "pharo.projects.hide",
					"when": "false"
				},
				{
					"command": "pharo.projects.unhide",
					"when": "false"
				},
				{
					"command": "pharo.projects.newPackage",
					"when": "false"
				},
				{
					"command": "pharo.projects.newClass",
					"when": "false"
				},
				{
					"command": "pharo.projects.runTests",
					"when": "false"
				},
				{
					"command": "pharo.projects.openDefinition",
					"when": "false"
				},
				{
					"command": "pharo.projects.newMethod",
					"when": "false"
				},
				{
					"command": "pharo.projects.commit",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "pharo.env.openEntity",
					"when": "pharo.envEdit && resourceScheme == pharoImage && resourceFilename =~ /\\.class\\.st$/",
					"group": "navigation@3"
				},
				{
					"command": "pharo.env.newMethod",
					"when": "pharo.envEdit && resourceScheme == pharoImage && resourceFilename =~ /\\.class\\.st$/",
					"group": "navigation@4"
				},
				{
					"command": "pharo.createPackage",
					"when": "resourceScheme == pharoImage && explorerResourceIsFolder && (explorerResourceIsRoot || resourcePath == '/')",
					"group": "navigation@1"
				},
				{
					"command": "pharo.createClass",
					"when": "resourceScheme == pharoImage && explorerResourceIsFolder && resourcePath =~ /^\\/[^\\/]+$/",
					"group": "navigation@2"
				}
			],
			"scm/title": [
				{
					"command": "pharo.ice.commit",
					"when": "scmProvider == pharo-iceberg",
					"group": "navigation@1"
				},
				{
					"command": "pharo.ice.push",
					"when": "scmProvider == pharo-iceberg",
					"group": "navigation@2"
				},
				{
					"command": "pharo.ice.refresh",
					"when": "scmProvider == pharo-iceberg",
					"group": "navigation@3"
				}
			]
		},
		"keybindings": [
			{
				"command": "pharo.showIt",
				"key": "ctrl+alt+i"
			},
			{
				"command": "pharo.printIt",
				"key": "ctrl+alt+p"
			},
			{
				"command": "pharo.doIt",
				"key": "ctrl+alt+d"
			}
		],
		"debuggers": [
			{
				"type": "pharodb",
				"label": "Pharo Debug",
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "%debuggers.pharodb.launch.program.description%",
								"default": "${workspaceFolder}/${command:AskForProgramName}"
							}
						}
					}
				}
			}
		],
		"commandPalette": [
			{
				"command": "extension.pharo-debug.debugEditorContents",
				"when": "resourceLangId == pharo"
			}
		],
		"snippets": [
			{
				"language": "pharo",
				"path": "./snippets/snippets.json"
			}
		],
		"walkthroughs": [
			{
				"id": "setup",
				"title": "Set Up PLS",
				"description": "%walkthrough.setup.description%",
				"steps": [
					{
						"id": "downloadImage",
						"title": "Download Pharo Language Server Image",
						"description": "%walkthrough.setup.steps.downloadImage.description%",
						"media": {
							"image": "media/releases.png",
							"altText": ""
						}
					},
					{
						"id": "downloadVM",
						"title": "Download Pharo VM",
						"description": "%walkthrough.setup.steps.downloadVM.description%",
						"media": {
							"image": "media/vms.png",
							"altText": ""
						}
					},
					{
						"id": "modifySetting",
						"title": "Update Setting",
						"description": "%walkthrough.setup.steps.modifySetting.description%",
						"media": {
							"image": "media/pharo-bar.svg",
							"altText": ""
						}
					}
				]
			}
		],
		"notebooks": [
			{
				"type": "moosebook",
				"displayName": "Moosebook",
				"selector": [
					{
						"filenamePattern": "*.moosebook"
					}
				]
			}
		]
	},
	"scripts": {
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"test": "npm run compile && node ./dist/test/runTest.js",
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch",
		"test-compile": "tsc -p ./"
	},
	"dependencies": {
		"@microsoft/vscode-file-downloader-api": "^1.0.1",
		"@vscode/debugprotocol": "^1.68.0",
		"jsonc-parser": "^3.3.1",
		"vscode-languageclient": "^10.1.0",
		"vscode-languageserver-protocol": "3.18.2"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.0",
		"@types/vscode": "^1.125.0",
		"@typescript-eslint/parser": "^8.63.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"eslint": "^10.6.0",
		"mocha": "^11.7.6",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"webpack": "^5.108.4",
		"webpack-cli": "^7.2.1"
	}
}
